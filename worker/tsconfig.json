{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM"],
    "types": ["@cloudflare/workers-types", "node"], "strict": true, "noUncheckedIndexedAccess": false,
    "skipLibCheck": true, "noEmit": true, "isolatedModules": true, "resolveJsonModule": true
